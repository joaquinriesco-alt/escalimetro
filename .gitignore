.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json
.railway/

# --- Python ----------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/
venv/
build/
dist/

# --- outputs regenerables --------------------------------------------------
cases/900_synthetic_fixture/outputs/
cases/*/outputs/*.png

# --- E27: estado del servicio web -------------------------------------------
# Todo lo que produce la app (uploads, cases, briefs, corridas, revisiones) vive en DATA_DIR.
# En Railway es el volumen /data; en local, ./.data. Nunca entra al repo.
.data/

# --- sistema ---------------------------------------------------------------
.DS_Store

# informe generado por el runner en cada arranque
ESCALIMETRO_E09_REAL_REPORT.html

# archivo por corrida (E12): evidencia de ejecución, no fuente. Se regenera en cada arranque y crece
# ~6 MB por corrida; se conserva en el disco del servicio, no en el repo.
cases/*/ai/runs/

# manifiesto de la corrida en curso (E12): estado de ejecución, no fuente. Se reescribe en cada
# arranque del servicio; versionarlo hace que cada corrida ensucie el diff.
cases/*/ai/E09/run_manifest.json
