# ESCALÍMETRO — variables de entorno de la capa de IA (E08).
# Copiar a .env y completar. .env NUNCA se versiona (ver .gitignore).
# Este archivo contiene SÓLO nombres de variables. Ningún valor real, nunca.

# --- credenciales ---------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- modelos por propósito (cambiables sin tocar código) -------------------------------------------
OPENAI_MODEL_VISION=
OPENAI_MODEL_PRESENTATION=
ANTHROPIC_MODEL_REVIEWER=

# --- comportamiento de los proveedores -------------------------------------------------------------
AI_PROVIDER_TIMEOUT=
AI_PROVIDER_MAX_RETRIES=

# --- apagar un propósito sin quitar la credencial (opcional) ---------------------------------------
# AI_DISABLE_SPATIAL_REVIEW=1
# AI_DISABLE_VISUAL_REVIEW=1
# AI_DISABLE_PRESENTATION=1

# --- tabla de precios alternativa para la telemetría de costo (opcional) ---------------------------
